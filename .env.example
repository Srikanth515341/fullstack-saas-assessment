# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# Optional — Section C Level 2 features. Everything works without these;
# password reset / email verification / team invites just log the email to
# the console instead of sending it, OAuth buttons stay hidden, and avatar
# upload falls back to local disk storage.
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=

# Optional — Section C Level 3 features. Everything works without these too.
# Rate limiting (#18) and real-time updates (#19) are always-on local stubs,
# no env vars needed. Metered billing (#22) works against this app's real
# Stripe test credentials above — run `pnpm stripe:setup-metered` once to
# create the Billing Meter + metered price.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# AI task suggestions (#24) — set exactly one of these (or set AI_PROVIDER
# explicitly if you have more than one and want to pick). With none set, the
# feature falls back to canned suggestions, still "streamed" progressively.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=